<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YierPet.Windows</AssemblyName>
    <RootNamespace>YierPet.Windows</RootNamespace>
    <Version>0.0.2</Version>
    <AssemblyVersion>0.0.2.0</AssemblyVersion>
    <FileVersion>0.0.2.0</FileVersion>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app-icon.png" />
    <Content Include="Assets\app-icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\content\wechat\**\*.json;..\..\content\wechat\**\*.png;..\..\content\wechat\**\*.gif;..\..\content\wechat\**\*.jpg;..\..\content\wechat\**\*.jpeg;..\..\content\wechat\**\*.webp" Exclude="..\..\content\wechat\review\**\*;..\..\content\wechat\compiled\motion-run-v1.png">
      <Link>Content\wechat\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
