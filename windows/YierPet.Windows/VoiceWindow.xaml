<Window x:Class="YierPet.Windows.VoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一二和布布 · 语音工坊" Width="800" Height="840" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#F7F2EC" Foreground="#412D26"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Icon="pack://application:,,,/YierPet.Windows;component/Assets/app-icon.png">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,6"/><Setter Property="Background" Value="#F0DED1"/><Setter Property="BorderBrush" Value="#DCC7B6"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,3,0,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,4,16,6"/></Style>
    </Window.Resources>
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Bottom" Background="#EEE6DC" CornerRadius="10" Padding="12" Margin="0,12,0,0">
            <TextBlock x:Name="Status" Text="正在读取声音配置…" AutomationProperties.LiveSetting="Polite"/>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <WrapPanel>
                <Button x:Name="GenerateButton" Content="生成并试听" Click="GenerateClick" Background="#A95F43" Foreground="White"/>
                <Button x:Name="CancelButton" Content="取消生成" Click="CancelClick" IsEnabled="False"/>
                <Button x:Name="ReplayButton" Content="重播" Click="ReplayClick" IsEnabled="False"/>
                <Button Content="停止播放" Click="StopClick"/>
                <Button x:Name="DownloadButton" Content="下载 WAV" Click="DownloadClick" IsEnabled="False"/>
            </WrapPanel>
            <TextBlock x:Name="OutputLabel" Foreground="#85756C" Text="还没有生成语音。"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <TextBlock Text="让一二和布布说句话" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="只在生成新台词时加载模型，完成后自动卸载。平时播放已有音频即可。" Foreground="#85756C" Margin="0,6,0,16"/>
                <StackPanel x:Name="Configuration">
                    <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1  选择声音" FontWeight="SemiBold" FontSize="16"/>
                            <ComboBox x:Name="CharacterBox" SelectedIndex="0" SelectionChanged="CharacterChanged" Padding="8" Margin="0,10,0,10" AutomationProperties.Name="选择角色">
                                <ComboBoxItem Content="一二的声音"/><ComboBoxItem Content="布布的声音"/>
                            </ComboBox>
                            <TextBlock x:Name="PresetSummary" Foreground="#76665C" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <Button Content="使用默认声音" Click="DefaultClick" ToolTip="载入本机两位角色的默认模型及参考录音，替换当前两位配置"/>
                                <Button Content="导入声音预设" Click="ImportClick"/>
                                <Button Content="重新读取配置" Click="ReloadClick" ToolTip="丢弃未保存的编辑，重新载入磁盘配置"/>
                                <Button Content="使用教程" Click="GuideClick"/>
                            </WrapPanel>
                            <TextBlock Text="本机语音服务" Margin="0,6,0,0"/>
                            <DockPanel>
                                <Button Content="检查准备情况" Click="CheckClick" DockPanel.Dock="Right" Margin="8,3,0,10"/>
                                <TextBox x:Name="EndpointBox" AutomationProperties.Name="本机语音服务地址"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="2  写下这次想说的话" FontWeight="SemiBold" FontSize="16"/>
                            <TextBox x:Name="TextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="85" MaxLength="1000" Margin="0,10,0,10" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="要生成的台词"/>
                            <WrapPanel>
                                <CheckBox x:Name="ClarityBox" Content="轻度清晰化" Click="OptionsChanged" ToolTip="轻度均衡并调整音量；原生成音也会保留。不改变模型、音高或语速。"/>
                                <CheckBox x:Name="ReminderSpeechBox" Content="健康提醒自动说话" Click="OptionsChanged"/>
                            </WrapPanel>
                            <TextBlock Text="提醒会播放预先生成的角色语音，无需开启服务。生成或试听期间，提醒只显示文字，避免声音重叠。" Foreground="#85756C"/>
                        </StackPanel>
                    </Border>
                    <Expander Header="高级设置 · 模型、参考录音与保存" Margin="0,0,0,10">
                        <StackPanel Margin="4,12,4,0">
                            <CheckBox x:Name="OnDemandBox" Content="按需启动，生成后立即卸载（推荐）" Click="OptionsChanged"/>
                            <TextBlock Text="关闭此项时，需自行启动和关闭外部服务。打开窗口、检查文件、播放提醒均不会启动模型。" Foreground="#85756C"/>
                            <TextBlock Text="语音环境 Python（python.exe）" Margin="0,10,0,0"/>
                            <DockPanel><Button Content="选择文件" Tag="python" Click="BrowseClick" DockPanel.Dock="Right" Margin="8,3,0,10"/><TextBox x:Name="PythonBox" AutomationProperties.Name="语音环境 Python"/></DockPanel>
                            <TextBlock Text="GPT-SoVITS 根目录（选择其中的 api_v2.py）"/>
                            <DockPanel><Button Content="选择目录内文件" Tag="repo" Click="BrowseClick" DockPanel.Dock="Right" Margin="8,3,0,10"/><TextBox x:Name="RepositoryBox" AutomationProperties.Name="GPT-SoVITS 目录"/></DockPanel>
                            <TextBlock Text="推理配置（.yaml）"/>
                            <DockPanel><Button Content="选择文件" Tag="config" Click="BrowseClick" DockPanel.Dock="Right" Margin="8,3,0,10"/><TextBox x:Name="RuntimeConfigBox" AutomationProperties.Name="推理配置"/></DockPanel>
                            <TextBlock Text="GPT 模型（.ckpt）"/>
                            <DockPanel><Button Content="选择文件" Tag="gpt" Click="BrowseClick" DockPanel.Dock="Right" Margin="8,3,0,10"/><TextBox x:Name="GptBox" AutomationProperties.Name="GPT 模型路径"/></DockPanel>
                            <TextBlock Text="SoVITS 模型（.pth / .ckpt）"/>
                            <DockPanel><Button Content="选择文件" Tag="sovits" Click="BrowseClick" DockPanel.Dock="Right" Margin="8,3,0,10"/><TextBox x:Name="SovitsBox" AutomationProperties.Name="SoVITS 模型路径"/></DockPanel>
                            <TextBlock Text="参考录音（3–10 秒中文单人录音）"/>
                            <DockPanel><Button Content="选择文件" Tag="reference" Click="BrowseClick" DockPanel.Dock="Right" Margin="8,3,0,10"/><TextBox x:Name="ReferenceBox" AutomationProperties.Name="参考录音路径"/></DockPanel>
                            <TextBlock Text="参考录音的逐字文字（不是本次新台词）"/>
                            <TextBox x:Name="PromptBox" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="54" AutomationProperties.Name="参考录音文字"/>
                            <TextBlock Text="模型版本备注"/>
                            <TextBox x:Name="VersionBox" AutomationProperties.Name="模型版本备注"/>
                            <TextBlock Text="清晰化工具（ffmpeg.exe）"/>
                            <DockPanel><Button Content="选择文件" Tag="ffmpeg" Click="BrowseClick" DockPanel.Dock="Right" Margin="8,3,0,10"/><TextBox x:Name="FfmpegBox" AutomationProperties.Name="FFmpeg 路径"/></DockPanel>
                            <WrapPanel>
                                <Button Content="保存配置" Click="SaveClick"/>
                                <Button Content="归档声音文件" Click="ArchiveClick" ToolTip="复制当前角色的两个模型和参考录音到桌宠数据目录；不复制运行环境"/>
                                <Button Content="打开语音文件夹" Click="FolderClick"/>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <Expander Header="第一次使用：三步开始">
                    <TextBlock Margin="4,10" LineHeight="23" Text="1. 本机有默认声音时会自动填好。若未配置，点击「使用默认声音」或导入声音包里的 voices.json。&#10;2. 点击「检查准备情况」。本机环境已配置时不用手动启动服务；其他电脑先按教程安装环境。&#10;3. 选择一二或布布，输入新台词，点击下方「生成并试听」。生成音会自动保存，也能下载 WAV；模型随即卸载。「取消生成」或关闭窗口也会结束本次按需服务。&#10;如果只想听健康提醒，不用启动服务；在角色右键菜单「健康提醒」选择类型即可。详细安装、迁移与排错步骤见「使用教程」。"/>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
