<Window x:Class="YierPet.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YierPet"
        Width="210"
        Height="214"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Cursor="Hand"
        Topmost="True"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        PreviewMouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewMouseMove="Window_MouseMove"
        PreviewMouseLeftButtonUp="Window_MouseLeftButtonUp"
        PreviewMouseRightButtonUp="Window_MouseRightButtonUp">
    <Grid Background="#01000000">
        <Image x:Name="PetImage"
               Width="154"
               Height="166"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom"
               Stretch="Fill"
               SnapsToDevicePixels="True" />
        <Border x:Name="HeatOverlay"
                Width="154"
                Height="166"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#E6FF3B30"
                Opacity="0"
                IsHitTestVisible="False" />
        <Popup x:Name="SpeechPopup"
               PlacementTarget="{Binding ElementName=PetImage}"
               Placement="Top"
               VerticalOffset="-6"
               AllowsTransparency="True"
               StaysOpen="False">
            <Border Background="#FDFDFD"
                    BorderBrush="#C8D4E8"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,8"
                    MaxWidth="280">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="8"
                                      Direction="270"
                                      ShadowDepth="2"
                                      Opacity="0.25" />
                </Border.Effect>
                <TextBlock x:Name="SpeechText"
                           Foreground="#17365D"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </Border>
        </Popup>
    </Grid>
</Window>
